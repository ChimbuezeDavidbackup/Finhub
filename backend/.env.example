# Finhub Environment Configuration
APP_NAME=Finhub
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# AI Confluence Provider (Gemini)
# Leave blank to use built-in heuristic/algorithmic confluence engine
GEMINI_API_KEY=

# Market Data Default Exchange ('binance' or 'bybit')
DEFAULT_EXCHANGE=binance

# Demo Account Starting Balance
DEMO_STARTING_BALANCE_USDT=10000.0

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
